# ==============================================================
# AI RAG Common Framework - Configuración de Entorno
# ==============================================================

# Entorno: development | staging | production
FRAMEWORK_ENV=development
LOG_LEVEL=INFO

# Proveedor por defecto: gemini | openai | anthropic | ollama
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash
DEFAULT_TEMPERATURE=0.7
DEFAULT_TIMEOUT_SECONDS=60.0
DEFAULT_MAX_RETRIES=3

# Llaves API de Proveedores (configura la que vayas a utilizar)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Ollama (si se usa localmente)
OLLAMA_BASE_URL=http://localhost:11434
